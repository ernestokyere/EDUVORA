>

    <div class="container">

        <div class="premium-card">


            <div class="premium-content">

                <span class="premium-label">
                    EDUVORA PREMIUM
                </span>

                <h2>
                    Unlock your
                    <span>full potential.</span>
                </h2>

                <p>
                    Get access to powerful learning
                    features designed to give you
                    a more personalized experience.
                </p>


                <button
                    class="premium-btn"
                    type="button"
                    disabled
                >
                    Coming Soon
                </button>

            </div>



            <div class="premium-features">

                <div>
                    ✓ Unlimited quizzes
                </div>

                <div>
                    ✓ Personalized study plans
                </div>

                <div>
                    ✓ AI Study Coach
                </div>

                <div>
                    ✓ Detailed analytics
                </div>

                <div>
                    ✓ Advanced practice tests
                </div>

                <div>
                    ✓ Ad-free experience
                </div>

            </div>

        </div>

    </div>

</section>

</main>



