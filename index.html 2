<!-- =========================================
     EDUCATION LEVEL MODAL
========================================= -->

<div
    class="modal-overlay"
    id="levelModal"
    onclick="closeModalOutside(event)"
>

    <div class="level-modal">


        <button
            class="modal-close"
            type="button"
            onclick="closeLevelModal()"
            aria-label="Close"
        >
            ×
        </button>


        <div class="modal-icon">
            🎓
        </div>


        <span class="section-label">
            GET STARTED
        </span>


        <h2>
            What's your
            <span>education level?</span>
        </h2>


        <p>
            Choose your level and we'll take you
            to the right learning experience.
        </p>



        <div class="modal-levels">


            <button
                type="button"
                onclick="selectLevel('Basic School')"
            >

                <span>📘</span>

                <div>

                    <strong>
                        Basic School
                    </strong>

                    <small>
                        Primary education
                    </small>

                </div>

                <b>→</b>

            </button>



            <button
                type="button"
                onclick="selectLevel('JHS')"
            >

                <span>🎓</span>

                <div>

                    <strong>
                        JHS
                    </strong>

                    <small>
                        Junior High School
                    </small>

                </div>

                <b>→</b>

            </button>



            <button
                type="button"
                onclick="selectLevel('SHS / SHTS')"
            >

                <span>🔬</span>

                <div>

                    <strong>
                        SHS / SHTS
                    </strong>

                    <small>
                        Senior High School
                    </small>

                </div>

                <b>→</b>

            </button>



            <button
                type="button"
                onclick="selectLevel('TVET')"
            >

                <span>🛠️</span>

                <div>

                    <strong>
                        TVET
                    </strong>

                    <small>
                        Technical & Vocational
                    </small>

                </div>

                <b>→</b>

            </button>

        </div>

    </div>

</div>



